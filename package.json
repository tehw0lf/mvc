{
  "name": "@tehw0lf/mvc",
  "version": "0.0.10",
  "description": "minimum viable css",
  "main": "index.css",
  "sass": "index.scss",
  "style": "index.css",
  "exports": {
    ".": {
      "sass": "./index.scss",
      "style": "./index.css",
      "default": "./index.css"
    },
    "./layout": {
      "sass": "./layout/layout.scss"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "sass index.scss dist/index.css --style=compressed --no-source-map && cp -r index.scss layout README.md dist/ && node -e \"const p=require('./package.json');delete p.scripts;delete p.devDependencies;require('fs').writeFileSync('dist/package.json',JSON.stringify(p,null,2)+'\\n')\""
  },
  "devDependencies": {
    "sass": "^1.96.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tehw0lf/mvc.git"
  },
  "keywords": [
    "scss",
    "layout",
    "minimal"
  ],
  "author": "tehw0lf",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tehw0lf/mvc/issues"
  },
  "homepage": "https://github.com/tehw0lf/mvc#readme"
}
