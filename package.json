{
  "name": "@tehw0lf/mvc",
  "version": "0.0.9",
  "description": "minimum viable css",
  "main": "dist/index.css",
  "sass": "index.scss",
  "style": "dist/index.css",
  "exports": {
    ".": {
      "sass": "./index.scss",
      "style": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./layout": {
      "sass": "./layout/layout.scss"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.scss",
    "layout/",
    "dist/index.css"
  ],
  "scripts": {
    "build": "sass index.scss dist/index.css --style=compressed --no-source-map",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "sass": "^1.96.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tehw0lf/mvc.git"
  },
  "keywords": [
    "scss",
    "layout",
    "minimal"
  ],
  "author": "tehw0lf",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tehw0lf/mvc/issues"
  },
  "homepage": "https://github.com/tehw0lf/mvc#readme"
}
